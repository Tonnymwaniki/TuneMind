<?xml version="1.0" encoding="utf-8"?>
<!--
    Release-safe network security configuration.
    Forces HTTPS/WSS in production; cleartext overrides live in src/debug/res/xml/.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
