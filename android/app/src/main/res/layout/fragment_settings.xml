<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/tunemind_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent" android:layout_height="0dp"
        android:padding="16dp" android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView style="@style/Widget.TuneMind.Card"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView style="@style/Text.TuneMind.Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Permissions" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="Notification Access" android:textColor="@color/tunemind_text_primary" android:textSize="14sp" />
                        <TextView android:id="@+id/tv_notification" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="13sp" android:text="--" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_grant" style="@style/Widget.TuneMind.Button"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:text="Grant Access" android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/Widget.TuneMind.Card"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView style="@style/Text.TuneMind.Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Sync" />
                    <TextView android:id="@+id/tv_sync" style="@style/Text.TuneMind.Body"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_sync" style="@style/Widget.TuneMind.Button"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:text="Sync Now" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/Widget.TuneMind.Card"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView style="@style/Text.TuneMind.Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Data" />
                    <TextView android:id="@+id/tv_data" style="@style/Text.TuneMind.Body"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView style="@style/Widget.TuneMind.Card"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView style="@style/Text.TuneMind.Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Developer" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_debug" style="@style/Widget.TuneMind.Button.Outline"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:text="Open Diagnostics" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
