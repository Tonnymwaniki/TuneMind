<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/tunemind_bg">

    <com.google.android.material.card.MaterialCardView style="@style/Widget.TuneMind.Card"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <TextView style="@style/Text.TuneMind.Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Listening History" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" app:singleSelection="true" app:selectionRequired="true">
                <com.google.android.material.chip.Chip style="@style/Widget.TuneMind.Chip" android:id="@+id/chip_all" android:text="All" android:checked="true" />
                <com.google.android.material.chip.Chip style="@style/Widget.TuneMind.Chip" android:id="@+id/chip_identified" android:text="Identified" />
                <com.google.android.material.chip.Chip style="@style/Widget.TuneMind.Chip" android:id="@+id/chip_recurring" android:text="Recurring" />
            </com.google.android.material.chip.ChipGroup>

            <TextView android:id="@+id/tv_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:padding="32dp"
                android:text="No listening history yet."
                android:textColor="@color/tunemind_text_muted" android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_tracks" android:layout_width="match_parent" android:layout_height="0dp"
        android:paddingHorizontal="16dp" android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/card_recent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
