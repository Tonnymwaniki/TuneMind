<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.apps.youtube.music" />
        <package android:name="com.afmobi.boomplaymusic" />
        <package android:name="com.apple.android.music" />
        <package android:name="com.audiomack" />
        <package android:name="deezer.android.app" />
        <package android:name="com.amazon.mp3" />
        <package android:name="com.aspiro.tidal" />
        <package android:name="com.sec.android.app.music" />
        <package android:name="org.videolan.vlc" />
        <package android:name="com.maxmpz.audioplayer" />
        <package android:name="in.krosbits.musicolet" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="audio/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="audio/mpeg" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MUSIC" />
        </intent>
    </queries>

    <!--
        TuneMind is a passive observer of media sessions from other applications.
        NotificationListenerService binding is granted by the user through
        Settings → Notification Access.
    -->
    <application
        android:name=".TuneMindApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TuneMind"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.TuneMind"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Spotify OAuth 2.0 Authorization Code Redirect Callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="tunemind"
                    android:host="spotify-callback" />
            </intent-filter>
        </activity>

        <!-- Dedicated Spotify OAuth Callback Activity intercepting tunemind://spotify-auth-callback -->
        <activity
            android:name=".data.ingestion.AuthCallbackActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.TuneMind">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="tunemind"
                    android:host="spotify-auth-callback" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.TuneMind" />

        <!--
            TuneMindListenerService MUST have android:exported="true"
            so the Android system server process (NotificationManagerService) can bind to it.
            It is protected by android.permission.BIND_NOTIFICATION_LISTENER_SERVICE.
        -->
        <service
            android:name=".service.TuneMindListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Reasoning & Execution Branch: Autonomous Satiety Foreground Service & BroadcastReceiver -->
        <service
            android:name=".domain.execution.SatietyExecutionForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".domain.execution.SatietyDecisionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.tunemind.app.ACTION_SATIETY_DECISION" />
                <action android:name="com.tunemind.app.ACTION_EVALUATE_ROOM_HISTORY" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
