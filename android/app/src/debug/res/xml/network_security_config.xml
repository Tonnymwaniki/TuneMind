<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-only network security configuration.
    Allows local HTTP / WS (emulator, adb reverse, LAN dev server) without weakening release builds.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
