# TuneMind Environment Configuration
# Provide your Anthropic API key for real-time neuro-acoustic reasoning & discovery
ANTHROPIC_API_KEY=your_key_here
GEMINI_API_KEY=
API_KEY=

# Spotify Web API Credentials for acoustic enrichment
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# AssemblyAI API Key for Real-Time Speech-to-Text
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# ElevenLabs API Key and Voice ID for hyper-realistic TTS voice synthesis
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here

# Supabase PostgreSQL Database & Taste Genome
SUPABASE_URL=your_project_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: Path to custom env file
TUNEMIND_ENV_FILE=

# Runtime environment
NODE_ENV=development
